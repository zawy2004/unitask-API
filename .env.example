# Copy this file to .env on the EC2 host and fill in real values.
# Docker Compose loads .env automatically and forwards to the container.
# .NET maps double-underscore env vars to config sections:
#   ConnectionStrings__UnitaskDb   ->  ConnectionStrings:UnitaskDb
#   JwtSettings__Secret            ->  JwtSettings:Secret
#   RAG__Groq__ApiKey              ->  RAG:Groq:ApiKey

# ---- PostgreSQL / Supabase ----
# Dùng SESSION POOLER (IPv4) của Supabase — direct db.*.supabase.co chỉ IPv6, EC2 không kết nối được.
# Lấy tại: Supabase Dashboard -> Connect -> Session pooler. Format Npgsql (keyword), KHÔNG phải URI.
#   Host=aws-0-<region>.pooler.supabase.com; user=postgres.<project-ref>; port 5432 (session).
ConnectionStrings__UnitaskDb=Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.YOUR_PROJECT_REF;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;Maximum Pool Size=20;Minimum Pool Size=2;

# ---- JWT (must be >= 32 chars, generate with: openssl rand -base64 48) ----
JwtSettings__Secret=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JwtSettings__Issuer=unitask-api
JwtSettings__Audience=unitask-client
JwtSettings__ExpiryMinutes=120
JwtSettings__RefreshExpiryDays=7

# ---- CORS (add your Vercel domain in addition to *.vercel.app wildcard) ----
Cors__AllowedOrigins__0=https://your-frontend.vercel.app

# ---- RAG (Groq + Qdrant) ----
RAG__UseLLM=Groq
RAG__Groq__ApiKey=REPLACE_WITH_GROQ_KEY
RAG__Groq__Model=llama-3.3-70b-versatile
RAG__Groq__Endpoint=https://api.groq.com/openai/v1/chat/completions
RAG__Qdrant__Url=https://your-cluster.qdrant.cloud
RAG__Qdrant__ApiKey=REPLACE_WITH_QDRANT_KEY
RAG__Qdrant__CollectionName=unitask
RAG__Qdrant__VectorSize=384

# ---- Email (Gmail SMTP + App Password) ----
# Tạo App Password tại: https://myaccount.google.com/apppasswords (cần bật 2-Step Verification trước)
EmailSettings__Host=smtp.gmail.com
EmailSettings__Port=587
EmailSettings__UseSsl=false
EmailSettings__Username=your-gmail@gmail.com
EmailSettings__Password=REPLACE_WITH_16_CHAR_APP_PASSWORD
EmailSettings__FromEmail=your-gmail@gmail.com
EmailSettings__FromName=UniTask
EmailSettings__FrontendBaseUrl=https://unitask.io.vn
EmailSettings__Enabled=true
